{
  "metadata": {"atespace": "substrate-lab", "name": "least-privilege"},
  "workerSelector": {"matchLabels": {"workload": "privilege-lab"}},
  "containers": [{
    "name": "probe",
    "image": "${PROBE_IMAGE}",
    "command": ["/probe"],
    "securityContext": {"capabilities": {"drop": ["ALL"]}},
    "env": [{"name": "EGRESS_URL", "value": "http://echo.substrate-lab.svc.cluster.local:8080/"}],
    "wakeupProbe": {"httpGet": {"path": "/readyz", "port": 80}},
    "volumeMounts": [{"name": "data", "mountPath": "/home/probe"}]
  }],
  "volumes": [{"name": "data", "durableDir": {}}],
  "resources": {"limits": [{"name": "cpu", "quantity": "1"}, {"name": "memory", "quantity": "512Mi"}]},
  "sandboxConfig": {"sandboxClass": "SANDBOX_CLASS_GVISOR", "configName": "gvisor-default"},
  "snapshotConfig": {"onCommit": "SNAPSHOT_CONTENT_SCOPE_FULL", "storageLocation": "gs://ate-snapshots/privilege-lab/"}
}
