# Example only. Never commit a real client secret.
# Sarah registers this confidential OAuth client in Entra, grants delegated
# Azure DevOps MCP permissions, and adds the matching HTTPS redirect URI used by
# the deployed Solo Enterprise UI callback.
apiVersion: v1
kind: Secret
metadata:
  name: azure-devops-mcp-elicitation
  namespace: agentgateway-system
type: Opaque
stringData:
  app_id: azure-devops-mcp
  client_id: REPLACE_WITH_ELICITATION_APP_CLIENT_ID
  client_secret: REPLACE_WITH_ELICITATION_APP_CLIENT_SECRET
  authorize_url: https://login.microsoftonline.com/11111111-2222-3333-4444-555555555555/oauth2/v2.0/authorize
  access_token_url: https://login.microsoftonline.com/11111111-2222-3333-4444-555555555555/oauth2/v2.0/token
  redirect_uri: https://your-solo-ui.example.com/age/elicitations
  scopes: openid profile email offline_access api://2a72489c-aab2-4b65-b93a-a91edccf33b8/.default
  type: oauth
