# One namespace per portfolio, one backend + route per deployed agent, and a
# JWT policy per portfolio. Rendered by scripts/40-gateway-config.sh with the
# runtime ARNs captured in deploy/.env.runtimes.
#
# The backends use the EnterpriseAgentgatewayBackend kind, which needs the
# v2026.8.1 charts or later: at v2026.8.0 the SCHEMA accepts spec.aws but the
# control plane fails to translate it (status Accepted=False TranslationError
# "unknown backend", route 500). Held on v2026.8.0? Swap to the OSS
# AgentgatewayBackend kind (apiVersion agentgateway.dev/v1alpha1, and the
# route backendRefs group): same aws + assumeRole fields, translates fine
# under the enterprise control plane.
#
# The interesting lines are each backend's spec.aws.agentCore.agentRuntimeArn
# (account + region ride inside the ARN; the gateway derives the regional
# endpoint and SigV4 config from it) and spec.policies.auth.aws.assumeRole
# (the per-portfolio STS hop; the session is named from the caller's verified
# JWT so it lands in that account's CloudTrail).
apiVersion: v1
kind: Namespace
metadata: { name: portfolio-a }
---
apiVersion: v1
kind: Namespace
metadata: { name: portfolio-b }
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: poet
  namespace: portfolio-a
spec:
  aws:
    agentCore:
      agentRuntimeArn: ${PORTFOLIO_A_POET_ARN}
      qualifier: DEFAULT
  policies:
    auth:
      aws:
        assumeRole:
          roleArn: ${PORTFOLIO_A_INVOKE_ROLE_ARN}
          sessionNameExpression: 'jwt.preferred_username'
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: quant
  namespace: portfolio-a
spec:
  aws:
    agentCore:
      agentRuntimeArn: ${PORTFOLIO_A_QUANT_ARN}
      qualifier: DEFAULT
  policies:
    auth:
      aws:
        assumeRole:
          roleArn: ${PORTFOLIO_A_INVOKE_ROLE_ARN}
          sessionNameExpression: 'jwt.preferred_username'
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: poet
  namespace: portfolio-b
spec:
  aws:
    agentCore:
      agentRuntimeArn: ${PORTFOLIO_B_POET_ARN}
      qualifier: DEFAULT
  policies:
    auth:
      aws:
        assumeRole:
          roleArn: ${PORTFOLIO_B_INVOKE_ROLE_ARN}
          sessionNameExpression: 'jwt.preferred_username'
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: quant
  namespace: portfolio-b
spec:
  aws:
    agentCore:
      agentRuntimeArn: ${PORTFOLIO_B_QUANT_ARN}
      qualifier: DEFAULT
  policies:
    auth:
      aws:
        assumeRole:
          roleArn: ${PORTFOLIO_B_INVOKE_ROLE_ARN}
          sessionNameExpression: 'jwt.preferred_username'
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: poet
  namespace: portfolio-a
spec:
  parentRefs: [{ name: ${GW_NAME}, namespace: ${GW_NS} }]
  hostnames: ["${AGENTS_HOST}"]
  rules:
    - matches: [{ path: { type: PathPrefix, value: /portfolio-a/poet } }]
      backendRefs:
        - group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
          name: poet
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: quant
  namespace: portfolio-a
spec:
  parentRefs: [{ name: ${GW_NAME}, namespace: ${GW_NS} }]
  hostnames: ["${AGENTS_HOST}"]
  rules:
    - matches: [{ path: { type: PathPrefix, value: /portfolio-a/quant } }]
      backendRefs:
        - group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
          name: quant
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: poet
  namespace: portfolio-b
spec:
  parentRefs: [{ name: ${GW_NAME}, namespace: ${GW_NS} }]
  hostnames: ["${AGENTS_HOST}"]
  rules:
    - matches: [{ path: { type: PathPrefix, value: /portfolio-b/poet } }]
      backendRefs:
        - group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
          name: poet
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: quant
  namespace: portfolio-b
spec:
  parentRefs: [{ name: ${GW_NAME}, namespace: ${GW_NS} }]
  hostnames: ["${AGENTS_HOST}"]
  rules:
    - matches: [{ path: { type: PathPrefix, value: /portfolio-b/quant } }]
      backendRefs:
        - group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
          name: quant
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: agent-jwt
  namespace: portfolio-a
spec:
  targetRefs:
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: poet }
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: quant }
  traffic:
    jwtAuthentication:
      mode: Strict
      providers:
        - issuer: ${KEYCLOAK_ISSUER}
          audiences: ["ar-backend"]
          jwks:
            remote:
              url: http://keycloak.${KEYCLOAK_NS}.svc.cluster.local:8080/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: agent-jwt
  namespace: portfolio-b
spec:
  targetRefs:
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: poet }
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: quant }
  traffic:
    jwtAuthentication:
      mode: Strict
      providers:
        - issuer: ${KEYCLOAK_ISSUER}
          audiences: ["ar-backend"]
          jwks:
            remote:
              url: http://keycloak.${KEYCLOAK_NS}.svc.cluster.local:8080/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
