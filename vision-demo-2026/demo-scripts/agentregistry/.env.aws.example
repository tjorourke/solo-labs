# Copy to .env.aws (gitignored) for the AWS Bedrock AgentCore beats of Part 4.
# Everything else in the suite runs without AWS.
export AWS_PROFILE="<your AWS CLI profile>"
export AWS_REGION="us-east-1"
# The account the AgentCore push must land in. The scripts refuse to create anything
# if the session is in a different account.
export EXPECTED_AWS_ACCOUNT="<12-digit account id>"
# A git repo you can push to: AgentCore builds the agent from source.
export AGENT_GIT_URL="https://github.com/<you>/agentregistry-agentcore-demo.git"
export AGENT_GIT_BRANCH="main"
