# Keys for the vision demo suite. Copy to secrets.env (gitignored) and fill in.
# Every script reads ./secrets.env by default; SECRETS_FILE=/path/to/file overrides it.
# Plain KEY=value lines: the scripts load this with `set -a; . secrets.env`.

# Solo Enterprise licences (required for Parts 1-4, 7, 8, 11-13 and the EKS cluster).
SOLO_ISTIO_LICENSE_KEY=
AGENTGATEWAY_LICENSE_KEY=
# Optional: the Gloo Platform UI falls back to SOLO_ISTIO_LICENSE_KEY.
GLOO_PLATFORM_LICENSE_KEY=
# kagent Enterprise (Part 4, Part 5/12 substrate). Falls back to SOLO_LICENSE_KEY.
KAGENT_ENT_LICENSE_KEY=
SOLO_LICENSE_KEY=

# The one live model provider (Parts 5, 7, 11, 13 and the EKS frontier route).
# Calls are billed to this key.
ANTHROPIC_API_KEY=

# Part 8 only: a GitHub token with read access is enough.
GITHUB_PAT=
