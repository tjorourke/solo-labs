# The EKS GPU cluster for the model-routing pages. Copy to eks.env (gitignored).
# Read by demo-scripts/eks.sh. Use your own AWS account: nothing here is shared.

# The AWS CLI profile to build with. Named explicitly so a profile exported in your
# shell for something else is never used by accident.
AWS_PROFILE=
# The 12-digit account that profile must be in. eks.sh refuses to run if it is not.
EXPECTED_AWS_ACCOUNT=

AWS_REGION=eu-west-2
# The GPU nodes and their weight volumes sit in one zone. Pick one where g7e.2xlarge
# capacity exists (see SETUP.md for the capacity reservation command).
GPU_AZ=eu-west-2a
EKS_CLUSTER=model-routing
# Goes on the cluster's Owner tag.
LAB_OWNER=

# Optional: an existing, publicly delegated Route53 zone you own, for real hostnames
# (agw.<zone> and soloui.<zone>). Needed for Cursor, Claude Desktop and the console's
# Agentdesktop and My agents pages; not needed for Gateway decisions or the tests.
ZONE=
