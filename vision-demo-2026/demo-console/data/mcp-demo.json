        {
          "kind": "tools/list",
          "title": "Load tool catalogue",
          "detail": "Two tools: get_tool and run_code. The 94 GitHub schemas stay on the gateway until the model asks for one.",
          "ms": 180,
          "tokens_in": 420,
          "tokens_out": 0,
          "write": false
