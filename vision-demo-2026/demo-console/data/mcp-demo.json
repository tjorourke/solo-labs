        {
          "kind": "run_code",
          "title": "run_code",
          "detail": "One program: list open PRs, fetch status, reviews and labels, return a 24-row summary.",
          "ms": 420,
          "tokens_in": 1640,
          "tokens_out": 380,
          "write": false,
          "program": "const prs = await github.pulls.list({repo, state:'open'});\nconst rows = await Promise.all(prs.map(async p => {\n  const [st, rv] = await Promise.all([\n    github.pulls.status(p.number),\n    github.pulls.reviews(p.number),\n  ]);\n  return {n:p.number, title:p.title, labels:p.labels, status:st, reviews:rv};\n}));\nreturn classify(rows);"
        },
        {
          "kind": "gateway",
          "title": "Gateway runs the program",
          "detail": "18 GitHub calls inside the sandbox. The model never sees the payloads.",
          "ms": 860,
          "tokens_in": 0,
          "tokens_out": 0,
          "write": false,
          "internal": true
        },
        {
          "kind": "answer",
