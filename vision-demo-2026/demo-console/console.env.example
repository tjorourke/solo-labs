# Per-laptop settings for the demo console. Copy to console.env (gitignored).
# run.sh loads it before starting the server.

# The EKS cluster behind Gateway decisions, Cost and My agents: its kubeconfig context.
# Left unset, the console looks for a context named model-routing or ending in
# cluster/model-routing.
MODEL_ROUTING_CONTEXT=model-routing

# The public hostnames scripts/platform/40-public-endpoints.sh published for that
# cluster (in the agentgateway-inference-task-routing-eks lab), without https://.
AGW_HOST=agw.example.com
SOLO_UI_HOST=soloui.example.com

# The key the gateway's JWKS trusts, used to sign the demo users' tokens. Defaults to
# ../../agentgateway-inference-task-routing-eks/identity/signing-key.pem, which
# scripts/01-identity.sh creates. Point it elsewhere for a cluster someone shared.
# MODEL_GATEWAY_SIGNING_KEY=/path/to/signing-key.pem

# Google Sovereign Cloud page (/google): the Berlin GCD agentgateway.
# Leave GCD_AGW_URL empty and the console port-forwards to the gateway itself
# using the Berlin kubeconfig. Set it once something already reaches the gateway.
#GCD_AGW_URL=
#GCD_LLM_HOST=models.agentic.eu0.internal
#GCD_KUBECONFIG=~/code/google-sov/poc/2026-09-agentic-platform/deploy/.kubeconfig
