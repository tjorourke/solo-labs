FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir grpcio==1.68.1 grpcio-tools==1.68.1 protobuf==5.28.3

COPY proto/ext_mcp.proto ./proto/ext_mcp.proto
RUN WELL_KNOWN=$(python -c "import grpc_tools; print(grpc_tools.__path__[0])")/_proto && \
    python -m grpc_tools.protoc \
      -I proto -I "$WELL_KNOWN" \
      --python_out=. --grpc_python_out=. \
      ext_mcp.proto

COPY policy_server.py .

EXPOSE 4445
CMD ["python", "policy_server.py"]
