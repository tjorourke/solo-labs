# versions.env — every version this lab pins, in one place. scripts/lib.sh sources it.
#
# OpenClaw 2.0 is the standalone baseline. kagent's OpenClaw backend image pins its own
# OpenClaw (2026.5.27 in kagent 0.10.1); scripts/04-harness.sh records what it finds.
OPENCLAW_VERSION="${OPENCLAW_VERSION:-2026.8.1}"
OPENCLAW_IMAGE="${OPENCLAW_IMAGE:-ghcr.io/openclaw/openclaw:2026.8.1-browser@sha256:7be09e8c5f5370c5b0ab2f68df243ae0db57646ee1208ba1b264527d12946a01}"

# kagent and Agent Substrate are a pair: kagent's go.mod replaces
# github.com/agent-substrate/substrate with the kagent-dev/substrate tag below.
# Bump them together and rerun ./scripts/quick.sh test.
KAGENT_VERSION="${KAGENT_VERSION:-0.10.1}"
SUBSTRATE_VERSION="${SUBSTRATE_VERSION:-0.0.9}"
ATEOM_IMAGE="${ATEOM_IMAGE:-ghcr.io/kagent-dev/substrate/ateom-gvisor:v0.0.9}"

KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:v1.35.0}"
GATEWAY_API_VERSION="${GATEWAY_API_VERSION:-v1.5.1}"
AGENTGATEWAY_VERSION="${AGENTGATEWAY_VERSION:-v1.5.0}"

MODEL_PROVIDER="${MODEL_PROVIDER:-anthropic}"
MODEL_NAME="${MODEL_NAME:-claude-sonnet-4-6}"
