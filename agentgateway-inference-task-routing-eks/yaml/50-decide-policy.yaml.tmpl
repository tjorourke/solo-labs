# The decision gateway's policy: verify the token again, then ask OPA.
#
# scripts/04-decision-gateway.sh renders yaml/50-decide-policy.yaml from this template with
# the JWKS from identity/jwks.json inlined.
#
# The classify listener preserved the bearer token, so this hop validates it itself and OPA acts on
# a subject the gateway verified, not on a header. forwardBody is on here, unlike Part 3:
# OPA needs the prompt for the data checks, a credential pattern or the bank's own code in
# the text. The task label arrives as the x-selected-model request header the router wrote.
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: decide
  namespace: agentgateway-system
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: decision-gateway
  frontend:
    # Telemetry for the Enterprise UI. The gateway exports a span per request to the
    # collector the management chart installs, and the dashboards and Cost Management
    # read those spans. Without this the UI installs cleanly and shows no data.
    # It lives on this policy rather than its own, because a second policy targeting the
    # same Gateway replaces the first rather than adding to it.
    tracing:
      backendRef:
        name: solo-enterprise-telemetry-collector
        namespace: agentgateway-system
        port: 4317
      protocol: GRPC
      randomSampling: "true"     # every request, which is what a demo wants
  traffic:
    phase: PreRouting
    jwtAuthentication:
      mode: Strict
      providers:
        - issuer: https://identity.lab
          audiences:
            - model-gateway
          jwks:
            inline: '__JWKS__'
    # FailClosed: an OPA outage is a refused request, not a default pool.
    extAuth:
      backendRef:
        name: opa
        namespace: agentgateway-system
        port: 9191
      grpc: {}
      # Big enough for a real editor session. A client sends its whole conversation every
      # turn, and a couple of pasted screenshots take it past a megabyte, at which point the
      # gateway forwards a fragment and the policy cannot read anything. The policy now says
      # so rather than skipping its checks, and this keeps an ordinary session under the
      # limit so it never has to.
      forwardBody:
        maxSize: 8Mi
      failureMode: FailClosed
