# The classify gateway's policy: verify the token, classify the task, hand on.
#
# scripts/05-classify-gateway.sh renders yaml/70-classify-policy.yaml from this template
# with the JWKS from identity/jwks.json inlined, and replaces Part 3's policy on the same
# Gateway.
#
# preserveToken keeps the bearer on the request after it has been verified, so the decision
# gateway can verify it again. Without it the gateway strips the Authorization header once
# the JWT has been checked. The router runs as extProc with the body buffered, writes the
# task label into the body's model field and into x-selected-model, and the route sends
# everything to the decision gateway.
#
# lint-crd-blocks: allow preserveToken
# The repo's cached AgentgatewayPolicy schema is the Enterprise 2026.8 chart's; preserveToken
# is on the OSS v1.5.0 CRD this lab runs (kubectl explain agentgatewaypolicy.spec.traffic.jwtAuthentication).
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: classify
  namespace: agentgateway-system
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: model-gateway
      sectionName: http
  frontend:
    # Telemetry for the Enterprise UI. The gateway exports a span per request to the
    # collector the management chart installs, and the dashboards and Cost Management
    # read those spans. Without this the UI installs cleanly and shows no data.
    # It lives on this policy rather than its own, because a second policy targeting the
    # same Gateway replaces the first rather than adding to it.
    tracing:
      backendRef:
        name: solo-enterprise-telemetry-collector
        namespace: agentgateway-system
        port: 4317
      protocol: GRPC
      randomSampling: "true"     # every request, which is what a demo wants
  traffic:
    phase: PreRouting
    jwtAuthentication:
      mode: Strict
      preserveToken: true
      providers:
        - issuer: https://identity.lab
          audiences:
            - model-gateway
          jwks:
            inline: '__JWKS__'
    # FailClosed: a router outage is a refused request, not an unclassified one sent on.
    extProc:
      backendRef:
        name: semantic-router
        namespace: agentgateway-system
        port: 50051
      processingOptions:
        requestHeaderMode: Send
        requestBodyMode: Buffered
        responseHeaderMode: Send
        # None, not Buffered. The router classifies the request; it has no use for the
        # response body. Buffering it breaks the Claude Code path: on /v1/messages the
        # backend hands back a translated Anthropic Messages response, the router cannot
        # read that shape, and what reaches the client is a correct envelope with an empty
        # content array (streaming stops after message_start). Measured on 2026-09-18,
        # agentgateway-enterprise 2026.9.0. The OpenAI path is unaffected either way.
        responseBodyMode: None
        allowModeOverride: true
      failureMode: FailClosed
