// Evaluated once in AGW PreRouting. Only verified JWT claims and the actual body
// participate. No caller-supplied routing/decision header is an input.
__DATA__.with(data,
  jwt.with(payload,
    (has(payload.sub) && payload.sub in data.users ? payload.sub
      : has(payload.sub) && has(payload.email) && type(payload.email) == string && payload.email.split("@")[0] in data.users
        ? payload.email.split("@")[0] : "").with(subject,
      (subject in data.users ? data.users[subject] : {"allowed_model_pools": []}).with(user,
        ("x-selected-model" in request.headers ? request.headers["x-selected-model"] : "").with(task,
          (task in data.routing.tasks ? data.routing.tasks[task] : {"pool": "", "class": ""}).with(table,
            json(request.body).with(body,
              (type(body) == map && size(request.body) <= 8388608).with(readable,
                (readable && has(body.messages) && type(body.messages) == list ? body.messages : []).with(messages,
                  messages.map(m,
                    has(m.content) && type(m.content) == string ? m.content
                    : has(m.content) && type(m.content) == list
                      ? m.content.filter(p, has(p.text) && type(p.text) == string).map(p, p.text).join(" ") : ""
                  ).join("\n").with(text,
                    ["AKIA[0-9A-Z]{16}", "-----BEGIN [A-Z ]*PRIVATE KEY-----", "sk-[A-Za-z0-9_-]{20,}", "gh[pousr]_[A-Za-z0-9]{30,}"].exists(p, text.matches(p)).with(secret,
                      (has(user.data_classes) && user.data_classes == true).with(classifies,
                        (classifies && readable && [
                          "(?i)ignore (all |any )?(previous|prior|your) (instructions|rules)",
                          "(?i)you (now )?have no (rules|restrictions)",
                          "(?i)(print|reveal|show) (me )?your system prompt",
                          "(?i)(password|passwort|kennwort)\\s*[:=]\\s*\\S+"
                        ].exists(p, text.matches(p))).with(jailbreak,
                          (data.dlp.internal_code_markers.exists(marker, text.contains(marker)) ||
                            ("x-source-repo" in request.headers && data.dlp.internal_repo_prefixes.exists(prefix, request.headers["x-source-repo"].startsWith(prefix)))).with(internal,
                            (classifies && readable ? data.dlp.data_classes.filter(c, text.matches(c.pattern)) : []).with(classes,
                              (classes.size() > 0 ? classes[0] : {"pool": "", "class": "", "why": ""}).with(dc,
                                ("private" in user.allowed_model_pools).with(privateAllowed,
                                  (!readable
                                    ? {"pool": privateAllowed ? "private" : "", "class": data.routing.vision_fallback_class, "reason": task + ", body too large to inspect"}
                                    : internal
                                      ? {"pool": privateAllowed && table.class != "" ? "private" : "", "class": table.class, "reason": task + ", internal code stays private"}
                                      : dc.pool != ""
                                        ? {"pool": table.class == "" ? "" : dc.pool in user.allowed_model_pools ? dc.pool : privateAllowed ? "private" : "", "class": table.class,
                                           "reason": task + ", " + dc.why + (dc.pool in user.allowed_model_pools ? "" : ", " + dc.pool + " not permitted")}
                                        : {"pool": table.pool in user.allowed_model_pools ? table.pool : table.pool != "" && privateAllowed ? "private" : "", "class": table.class,
                                           "reason": task + (table.pool in user.allowed_model_pools ? "" : ", frontier not permitted")}
                                  ).with(routed,
                                    messages.exists(m, has(m.content) && type(m.content) == list && m.content.exists(p,
                                      (has(p.type) && p.type in ["image_url", "image", "input_image"]) ||
                                      (has(p.content) && type(p.content) == list && p.content.exists(q, has(q.type) && q.type in ["image_url", "image", "input_image"]))
                                    )).with(image,
                                      (image && routed.pool == "private" && routed.class in data.routing.classes_without_vision).with(visionSwap,
                                        (readable && !image && routed.pool == "private" && routed.class != data.routing.long_context_class &&
                                          // Rego count(string) counts Unicode characters. This AGW
                                          // build's size(string) counts UTF-8 bytes. Keep the old
                                          // threshold for non-ASCII conversations as well.
                                          double(string(request.body).matches("[^\\x00-\\x7F]")
                                            ? string(request.body).split("").size() - "".split("").size()
                                            : size(request.body)) / data.routing.bytes_per_token +
                                            (has(body.max_tokens) && (type(body.max_tokens) == int || type(body.max_tokens) == uint || type(body.max_tokens) == double) ? double(body.max_tokens) : 0.0)
                                          > double(data.routing.small_window_tokens)).with(longSwap,
                                          {"user": subject, "task": task,
                                           "status": subject != "" && (secret || jailbreak) ? 422 : routed.pool != "" && subject != "" ? 200 : 403,
                                           "pool": routed.pool,
                                           "class": visionSwap ? data.routing.vision_fallback_class : longSwap ? data.routing.long_context_class : routed.class,
                                           "reason": subject != "" && secret ? "blocked, credential in prompt"
                                             : subject != "" && jailbreak ? "blocked, tries to override the model or carries a password"
                                             : routed.reason + (visionSwap ? ", image in prompt" : longSwap ? ", too long for the smaller window" : ""),
                                           "lane": classifies && readable ? (dc.class != "" ? dc.class : "public") : "",
                                           "error": secret ? "the prompt contains something that looks like a credential; remove it and try again"
                                             : jailbreak ? "Stopped at the Kernwerk gateway. This request tries to override the model's rules or carries a password, so no model received it."
                                             : "no suitable permitted backend for this task"}
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
