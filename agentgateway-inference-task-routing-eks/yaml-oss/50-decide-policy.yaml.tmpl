# Generated by scripts/render-native-routing.py. Business rules live in opa/routing.rego.
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: decide
  namespace: agentgateway-system
spec:
  # Attach to decision-gateway, so these checks run for its requests.
  targetRefs:
  - group: gateway.networking.k8s.io
    kind: Gateway
    name: decision-gateway
  traffic:
    # Make the decision before AGW selects an HTTPRoute.
    phase: PreRouting
    # Verify the signature, issuer and audience before forwarding claims to Rego.
    jwtAuthentication:
      mode: Strict
      providers:
      - issuer: https://identity.lab
        audiences:
        - model-gateway
        jwks:
          inline: '__JWKS__'
      - issuer: agentdesktop-controller
        audiences:
        - model-gateway
        jwks:
          inline: '__AD_JWKS__'
    # Rego evaluates group permissions and data rules. An unavailable service fails closed.
    extAuth:
      backendRef:
        name: routing-policy
        namespace: agentgateway-system
        port: 9191
      grpc: {}
      forwardBody:
        maxSize: 8Mi
      failureMode: FailClosed
    transformation:
      request:
        metadata:
          # Copy the trusted extAuth result. No users, permissions or decision programme live here.
          routing: extauthz.routing
          # Keep the original body for the decision dashboard.
          routing_body: string(request.body)
        # Overwrite caller-supplied routing headers with the trusted decision.
        set:
        - name: x-model-pool
          value: 'metadata.routing.status == 200 ? metadata.routing.pool : "denied"'
        - name: x-model-class
          value: metadata.routing.class
        - name: x-routing-reason
          value: metadata.routing.reason
        - name: x-routing-user
          value: metadata.routing.user
        - name: x-kernwerk-lane
          value: 'metadata.routing.lane != "" ? metadata.routing.lane : null'
      # Return the pool, model class and reason to the client where applicable.
      response:
        set:
        - name: x-model-pool
          value: 'metadata.routing.status == 200 ? metadata.routing.pool : null'
        - name: x-model-class
          value: 'metadata.routing.status == 200 ? metadata.routing.class : null'
        - name: x-routing-reason
          value: 'metadata.routing.status != 403 ? metadata.routing.reason : null'
  # Record the decision even when a later budget check refuses the request.
  frontend:
    accessLog:
      attributes:
        add:
        - name: routing.decision
          expression: toJson(metadata.routing)
        - name: routing.body
          expression: metadata.routing_body
