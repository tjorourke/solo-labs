{
  "roles": {
    "model-private": {"allowed_model_pools": ["private"]},
    "model-frontier": {"allowed_model_pools": ["approved-frontier"]},
    "model-eu": {"allowed_model_pools": ["eu-hosted"]},
    "data-classification": {"allowed_model_pools": [], "data_classes": true}
  },
  "routing": {
    "default_pool": "private",
    "tasks": {
      "code_review": {
        "pool": "private",
        "class": "coding"
      },
      "code_modification": {
        "pool": "private",
        "class": "coding"
      },
      "finance": {
        "pool": "private",
        "class": "finance"
      },
      "generic_coding": {
        "pool": "approved-frontier",
        "class": "coding"
      },
      "telco": {
        "pool": "private",
        "class": "telco"
      },
      "uncertain": {
        "pool": "private",
        "class": "general"
      }
    },
    "private_classes": [
      "coding",
      "finance",
      "general",
      "telco"
    ],
    "classes_without_vision": [
      "coding"
    ],
    "vision_fallback_class": "general",
    "long_context_class": "coding",
    "small_window_tokens": 131072,
    "bytes_per_token": 3.5
  },
  "dlp": {
    "internal_code_markers": [
      "com.example.internal",
      "settlement-service",
      "ledger-core",
      "com/example/internal",
      "finance-app/",
      "ledger-core/",
      "settlement-service/"
    ],
    "internal_repo_prefixes": [
      "git.internal/",
      "internal/"
    ],
    "data_classes": [
      {
        "class": "private",
        "label": "Class 3",
        "pool": "private",
        "why": "class 3, an attachment the gateway cannot read, or marked restricted",
        "pattern": "(?i)(klasse 3|class 3|streng vertraulich|kernwerk restricted|\\[\\[attachment\\]\\]|<uploaded_files>)"
      },
      {
        "class": "eu",
        "label": "Class 2",
        "pool": "eu-hosted",
        "why": "class 2, must stay in the EU",
        "pattern": "(?i)([a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}|\\bDE\\d{2} ?\\d{4}|\\bKW-\\d{6}\\b|\\+49|personal data|personenbezogen|personnel|personalakte)"
      }
    ]
  }
}
